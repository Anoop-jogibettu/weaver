+  padding: 0 7px; font-size: 11px; font-weight: 400;
+  color: var(--text-secondary);
+  background: transparent;
+  border: none;
+  border-radius: var(--radius-sm); cursor: pointer;
+  height: 22px; display: flex; align-items: center; gap: 3px;
+  transition: color 60ms, background 60ms;
+}
+.sync-host-btn:hover { color: var(--text-primary); background: rgba(255,255,255,0.05); }
+
+.merge-to-host-btn {
+  padding: 0 8px; font-size: 11px; font-weight: 500;
+  color: var(--accent-light);
+  background: transparent;
+  border: 1px solid rgba(94,129,172,0.3);
+  border-radius: var(--radius-sm); cursor: pointer;
+  height: 22px; display: flex; align-items: center; gap: 3px;
+  transition: background 60ms, border-color 60ms;
+}
+.merge-to-host-btn:hover { background: var(--accent-dim); border-color: var(--accent); }
+.merge-to-host-btn:disabled { opacity: 0.35; cursor: not-allowed; }
+
+.activity-log-toggle-btn {
+  padding: 0 7px; font-size: 11px; font-weight: 400;
+  color: var(--text-muted); background: transparent; border: none;
+  border-radius: var(--radius-sm); cursor: pointer;
+  height: 22px; display: flex; align-items: center; gap: 3px;
+  white-space: nowrap; transition: color 60ms, background 60ms;
+}
+.activity-log-toggle-btn:hover { color: var(--text-primary); background: rgba(255,255,255,0.05); }
+.activity-log-toggle-btn.active { color: var(--accent-light); }
+
+/* Run button — primary action, visually differentiated but not oversized */
+.editor-run-btn {
+  display: flex; align-items: center; gap: 5px;
+  padding: 0 14px; font-size: 11px; font-weight: 600;
+  color: #0d0f14;
+  background: var(--green);
+  border: none; border-radius: var(--radius-sm); cursor: pointer;
+  height: 22px; letter-spacing: 0.01em;
+  transition: background 60ms; flex-shrink: 0;
+}
+.editor-run-btn:hover:not(:disabled) { background: #a3c9c8; }
+.editor-run-btn:disabled { opacity: 0.4; cursor: not-allowed; }
+.editor-run-btn.running { background: var(--bg-control); color: var(--text-secondary); }
+
+/* Counter badge — restrained, no pill shape */
+.btn-counter-badge {
+  font-size: 9px; font-weight: 700;
+  background: var(--accent); color: #0d0f14;
+  padding: 0 4px; border-radius: 2px; line-height: 14px;
+  display: inline-block;
+}
+
+/* Editor wrap */
+.editor-wrap { flex: 1; overflow: hidden; display: flex; flex-direction: column; position: relative; }
+.editor-files-wrap { flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
+
+/* ─── CodeMirror Overrides ────────────────────────────────────────────────────
+   Dark theme for Apple Liquid Glass design
+──────────────────────────────────────────────────────────────────────────────*/
+.cm-editor {
+  height: 100% !important;
+  font-size: 13px !important;
+  font-family: var(--font-mono) !important;
+  background: var(--bg-base) !important;
+  color: var(--text-primary) !important;
+}
+.cm-editor.cm-focused { outline: none !important; }
+.cm-scroller { overflow: auto !important; }
+.cm-content { padding: 8px 0 !important; }
+.cm-line { padding: 0 16px !important; line-height: 1.65; }
+.cm-gutters {
+  background: var(--bg-base) !important;
+  border-right: 1px solid var(--border-light) !important;
+  color: #3d4252 !important;
+  padding: 0 !important; min-width: 42px;
+}
+.cm-gutter { min-width: 42px; }
+.cm-gutterElement { padding: 0 8px !important; text-align: right; font-size: 12px !important; }
+.cm-activeLineGutter { background: rgba(255,255,255,0.025) !important; color: #606773 !important; }
+.cm-activeLine { background: rgba(255,255,255,0.02) !important; }
+.cm-cursor { border-left-color: #abb2bf !important; border-left-width: 2px !important; }
+.cm-selectionBackground { background: var(--bg-selection) !important; }
+.cm-matchingBracket { background: rgba(255,255,255,0.06) !important; outline: 1px solid rgba(255,255,255,0.12) !important; }
+
+/* Remote cursors */
+.remote-cursor { border-left: 2px solid var(--green); display: inline; }
+.remote-cursor-label {
