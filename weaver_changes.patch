+  filename: string;
+  hostName: string;
+  collaboratorName: string;
+  hostContent: string;
+  collaboratorContent: string;
+  changes?: Array<{
+    node_type: string;
+    name: string;
+    operation: string;
+    line_start: number;
+    line_end: number;
