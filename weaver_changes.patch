+                    </pre>
+                  </div>
+                </div>
+              ) : (
+                <div className="snapshots-preview-empty">
+                  Select any snapshot from the timeline to inspect its file contents or restore it.
+                </div>
+              )}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
