{
  "name": "weaver",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:backend": "cd backend && node server.js",
    "start:python": "cd python-service && python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "test:python": "cd python-service && python3 -m pytest ../tests/test_python_service.py -v",
    "start": "bash start.sh"
  },
  "dependencies": {
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.34.2",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "codemirror": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^9.0.0",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.3.5"
  }
}
